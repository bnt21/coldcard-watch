# Syncthing's in-flight temp copies. These appear and vanish mid-sync, and one got
# swept into a commit by `git add -A` during an edit. The leak gate caught it.
.syncthing.*
*.tmp

# Working state. Regenerable, large, and some of it carries local filesystem paths.
*-state.json
*.log
__pycache__/
*.pyc
.backup/

# Deployment linkage. Ties the tree to a specific Vercel account and project.
.vercel/
public/.vercel/

# Node location and RPC credentials live outside the repo, in ~/.coldcard-node.json
# or the environment. Never commit either. See nodeconf.py.
.coldcard-node.json
*.local.json
.env
.env.*

.DS_Store

# Potential-layer address lists: victim addresses, never published to the public repo
sidecar/
